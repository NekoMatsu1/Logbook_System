{$LOGBOOK_DOMAIN} {
	@administrator remote_ip {$LOGBOOK_ADMIN_ADDRESS}
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:5000
	}
	handle @administrator {
		reverse_proxy 127.0.0.1:5000
	}
	handle {
		respond "Administrator access is restricted to the designated computer" 403
	}
}
